# Copia para .env.local e preenche. Na Vercel, define as mesmas variáveis em
# Project Settings → Environment Variables.

# Supabase → Project Settings → API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave "publishable" (sb_publishable_...) ou a antiga "anon" key. É pública por natureza;
# a proteção dos dados é feita pelo Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Só estes emails podem pedir código de acesso (separados por vírgulas).
ALLOWED_EMAIL=o-teu-email@exemplo.pt

# Opcional: URL pública da app, usada no link do email.
# Se ficar vazia, é deduzida do pedido (funciona em localhost e na Vercel).
# NEXT_PUBLIC_SITE_URL=https://mota.vercel.app

# --- Fase 2 (ainda não usadas) ---
# TRADING212_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
